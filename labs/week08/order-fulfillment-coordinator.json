    {
      "id": "d78faeae-5f0e-4a29-8817-f07b71818732",
      "name": "Validate Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// A webhook puts the JSON you POST under `body` (next to headers, params and query)\nconst order = $json.body ?? {};\nconst errors = [];\n\n// Check required fields\nif (!order.order_id) errors.push('Missing order_id');\nif (!order.customer?.name) errors.push('Missing customer name');\nif (!order.customer?.email) errors.push('Missing customer email');\nif (!order.items || !Array.isArray(order.items) || order.items.length === 0) {\n  errors.push('No items in order');\n}\n\n// Validate items\nif (order.items && Array.isArray(order.items)) {\n  order.items.forEach((item, i) => {\n    if (!item.product) errors.push(`Item ${i + 1}: missing product name`);\n    if (!item.quantity || item.quantity <= 0) errors.push(`Item ${i + 1}: invalid quantity`);\n    if (!item.unit_price || item.unit_price <= 0) errors.push(`Item ${i + 1}: invalid price`);\n  });\n}\n\n// Validate payment\nif (!['confirmed', 'pending'].includes(order.payment_status)) {\n  errors.push('Invalid payment status');\n}\n\nreturn {\n  json: {\n    ...order,\n    validation_passed: errors.length === 0,\n    validation_errors: errors,\n    validated_at: new Date().toISOString()\n  }\n};"
      }
    },
    {
      "id": "1e823dfd-62ac-41fd-bce4-7513863700ad",
      "name": "Validation Check",
      "type": "n8n-nodes-base.if",
