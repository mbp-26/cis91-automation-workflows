{"id":"VKhYyBtdGbN669Tv","name":"MP - Sentiment Analysis Pipeline","description":null,"active":false,"activeVersionId":null,"createdAt":"2026-11-03T19:05:10.789Z","updatedAt":"2026-11-03T20:26:19.403Z","isArchived":false,"versionId":"9b3ba25f-0b6e-437f-a1cd-dd21783568f3","versionCounter":65,"sourceWorkflowId":null,"triggerCount":1,"nodes":[{"id":"4877f723-7fb0-4cff-9866-87601ba750f7","name":"When clicking ‘Execute workflow’","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"parameters":{}},{"id":"ec2d52ac-ef2a-4094-b96d-5f5c7db02cdc","name":"Analyze Sentiment","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"alwaysOutputData":false,"position":[448,0],"parameters":{"promptType":"define","text":"=Analyze the sentiment of this product review.\n\nProduct: {{ $json.product }}\nReview: {{ $json.review_text }}\n\nClassify the sentiment as \"positive\", \"negative\", or \"neutral\". Include a\nconfidence from 0.0 to 1.0, the single strongest emotion (e.g., joy,\nfrustration, indifference, satisfaction, anger), and a one-sentence summary.","hasOutputParser":true,"options":{}}},{"id":"3d2613ba-d53c-4a98-9183-9fd148025ad8","name":"OpenRouter Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","typeVersion":1,"position":[368,208],"parameters":{"model":"deepseek/deepseek-v4.1-flash-1017","options":{"temperature":0}},"credentials":{"openRouterApi":{"id":"ihBbPEQQ2ykUgmyB","name":"MP - OpenRouter"}}},{"id":"acd5a448-9a2a-405e-984f-5d113e9d993a","name":"Structured Output Parser","type":"@n8n/n8n-nodes-langchain.outputParserStructured","typeVersion":1.3,"position":[656,208],"parameters":{"jsonSchemaExample":"{\n  \"sentiment\": \"positive\",\n  \"confidence\": 0.95,\n  \"key_emotion\": \"joy\",\n  \"summary\": \"one-sentence summary of the review\"\n}"}},{"id":"14836edf-b14f-4c02-8cdf-44c2dc152956","name":"Combine Results","type":"n8n-nodes-base.code","typeVersion":2,"position":[816,0],"parameters":{"mode":"runOnceForEachItem","jsCode":"// The Structured Output Parser puts the parsed object in $json.output\nconst aiResult = $json.output;\n// The original review this AI result came from\nconst review = $('Test Reviews').item.json;\n\nreturn {\n  json: {\n    review_id: review.review_id,\n    product: review.product,\n    reviewer: review.reviewer,\n    review_text: review.review_text,\n    date: review.date,\n    sentiment: aiResult.sentiment,\n    confidence: aiResult.confidence,\n    key_emotion: aiResult.key_emotion,\n    ai_summary: aiResult.summary\n  }\n};"}},{"id":"d572bf6a-d10c-4479-82a5-1e781039e992","name":"Test Reviews","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0],"parameters":{"jsCode":"return [\n  {\n    json: {\n      review_id: 'R001',\n      product: 'Wireless Earbuds Pro',\n      reviewer: 'Alice M.',\n      review_text: 'Absolutely love these earbuds! Sound quality is incredible and the battery lasts all day. Best purchase I made this year.',\n      date: '2026-03-01'\n    }\n  },\n  {\n    json: {\n      review_id: 'R002',\n      product: 'Wireless Earbuds Pro',\n      reviewer: 'Bob T.',\n      review_text: 'Terrible quality. The left earbud stopped working after two days. Customer service was unhelpful and rude. Want my money back.',\n      date: '2026-03-03'\n    }\n  },\n  {\n    json: {\n      review_id: 'R003',\n      product: 'Phone Case Ultra',\n      reviewer: 'Carol S.',\n      review_text: 'It is a phone case. It fits my phone and seems to protect it fine. Nothing special but nothing wrong with it either.',\n      date: '2026-03-05'\n    }\n  },\n  {\n    json: {\n      review_id: 'R004',\n      product: 'Laptop Stand Deluxe',\n      reviewer: 'David K.',\n      review_text: 'The stand wobbles slightly but overall improves my desk setup. Wish it was more adjustable. Decent for the price.',\n      date: '2026-03-07'\n    }\n  },\n  {\n    json: {\n      review_id: 'R005',\n      product: 'Laptop Stand Deluxe',\n      reviewer: 'Eve R.',\n      review_text: 'This completely transformed my workspace! Ergonomic, sturdy, and looks great. My neck pain is gone. Five stars easily!',\n      date: '2026-03-09'\n    }\n  }\n];\n"}},{"id":"e80c1aa8-4d90-457a-9580-dc8eb73459d2","name":"Route by Sentiment","type":"n8n-nodes-base.switch","typeVersion":3.5,"position":[1056,-16],"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":4},"conditions":[{"leftValue":"={{ $json.sentiment }}","rightValue":"positive","operator":{"type":"string","operation":"equals"},"id":"51f2a62e-f762-4607-9b72-7263db19cb86"}],"combinator":"and"},"renameOutput":true,"outputKey":"Positive"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":4},"conditions":[{"id":"51421664-315a-4006-a2e9-d7bb8135f3bc","leftValue":"={{ $json.sentiment }}","rightValue":"negative","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Negative"}]},"options":{"fallbackOutput":"extra","renameFallbackOutput":"Neutral/Mixed"}}},{"id":"6486702b-2384-4ab1-bdf8-24ea2ea1de9a","name":"Positive Action","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[1280,-224],"parameters":{"assignments":{"assignments":[{"id":"3699cf9d-1c76-4726-b444-8a282b9e4459","name":"action","value":"Feature in testimonials","type":"string"},{"id":"d4aa50da-c3de-467e-9c59-5c01dcb24233","name":"priority","value":"low","type":"string"},{"id":"578f79c9-3b23-47c8-bc1c-b4459a0880c8","name":"follow_up","value":"Send thank-you coupon","type":"string"}]},"includeOtherFields":true,"include":"all","options":{}}},{"id":"7dee91c8-3da9-4cdd-83a5-09e06384c548","name":"Negative Action","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[1280,0],"parameters":{"assignments":{"assignments":[{"id":"44f6e3e1-1f99-4bca-bf0e-4d8ec1383036","name":"action","value":"Escalate to customer success","type":"string"},{"id":"ee37ad1e-3e57-435b-8bc6-611864635004","name":"priority","value":"high","type":"string"},{"id":"681b6b7d-039e-4013-ab6b-f8cfc2dd3683","name":"follow_up","value":"Reach out within 24 hours","type":"string"}]},"includeOtherFields":true,"include":"all","options":{}}},{"id":"89ef69b6-f296-497d-a321-9b4d6e35644e","name":"Neutral Action","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[1280,224],"parameters":{"assignments":{"assignments":[{"id":"1c49414d-7cb9-4361-939b-0d62df27a8d3","name":"action","value":"Add to product feedback log","type":"string"},{"id":"2246bb23-c706-42c2-aa7a-bc6b3aedf865","name":"priority","value":"medium","type":"string"},{"id":"28e53f92-95c2-4971-8846-a65c906f90cd","name":"follow_up","value":"Include in weekly product review","type":"string"}]},"includeOtherFields":true,"include":"all","options":{}}},{"id":"50513ee7-bc46-45b4-a9cc-e7dc43bebea7","name":"Combine All","type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1520,0],"parameters":{"mode":"append","numberInputs":3,"options":{}}},{"id":"980b3d0e-c5f2-4535-9027-14a9af74f1b1","name":"Generate Dashboard","type":"n8n-nodes-base.code","typeVersion":2,"position":[1760,-96],"parameters":{"mode":"runOnceForAllItems","jsCode":"const items = $input.all();\nconst total = items.length;\nconst positive = items.filter(i => i.json.sentiment === 'positive').length;\nconst negative = items.filter(i => i.json.sentiment === 'negative').length;\nconst neutral = total - positive - negative;\nconst avgConfidence = items.reduce((sum, i) => sum + (i.json.confidence || 0), 0) / total;\nconst escalations = items.filter(i => i.json.priority === 'high').length;\n\nreturn [{\n  json: {\n    report_title: 'Sentiment Analysis Dashboard',\n    generated_at: new Date().toISOString(),\n    total_reviews: total,\n    positive_count: positive,\n    positive_pct: Math.round((positive / total) * 100) + '%',\n    negative_count: negative,\n    negative_pct: Math.round((negative / total) * 100) + '%',\n    neutral_count: neutral,\n    neutral_pct: Math.round((neutral / total) * 100) + '%',\n    average_confidence: Math.round(avgConfidence * 100) / 100,\n    escalations_needed: escalations\n  }\n}];"}},{"id":"dcedada7-98e7-4b49-837d-841bb466bcb1","name":"Log Reviews","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1760,128],"parameters":{"dataTableId":{"__rl":true,"value":"uso85pYGgCbCoKVV","mode":"list","cachedResultName":"MP Reviews","cachedResultUrl":"/projects/KhErxUHlDhLuuNMh/datatables/uso85pYGgCbCoKVV"},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":[],"schema":[{"id":"review_id","displayName":"review_id","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"product","displayName":"product","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"reviewer","displayName":"reviewer","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"review_text","displayName":"review_text","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"date","displayName":"date","required":false,"defaultMatch":false,"display":true,"type":"dateTime","readOnly":false,"removed":false},{"id":"sentiment","displayName":"sentiment","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"confidence","displayName":"confidence","required":false,"defaultMatch":false,"display":true,"type":"number","readOnly":false,"removed":false},{"id":"key_emotion","displayName":"key_emotion","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"ai_summary","displayName":"ai_summary","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":false},{"id":"action","displayName":"action","required":false,"defaultMatch":fa