<mxfile host="pi" type="device">
  <diagram id="flow1" name="Project flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Leaderboard game - request flow" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="0"><mxGeometry x="40" y="0" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="repo" value="1 - GitHub repo (public, zero secrets)&lt;br&gt;mbp-26/cis91-automation-workflows/pi-projects/leaderboard-game" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="330" y="40" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="cdn" value="raw.githack.com CDN&lt;br&gt;serves HTML+JS, cached per commit ref" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="330" y="140" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="game" value="2 - Game page (student)&lt;br&gt;index.html + leaderboard-client.js" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="60" y="250" width="280" height="64" as="geometry"/></mxCell>
        <mxCell id="board" value="2 - Projector page&lt;br&gt;board.html, polls every 5 s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="620" y="250" width="280" height="64" as="geometry"/></mxCell>
        <mxCell id="worker" value="3 - Cloudflare Worker relay&lt;br&gt;password check - CORS - optional KV rate limit&lt;br&gt;holds the n8n URLs as secrets" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="330" y="365" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="submit" value="4 - n8n: Submit workflow&lt;br&gt;Check Password - Validate+Score - Insert - Rank" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="60" y="500" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="list" value="4 - n8n: List workflow&lt;br&gt;Check Password - Sort" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="600" y="500" width="300" height="68" as="geometry"/></mxCell>
        <mxCell id="table" value="Data Table: cis-leaderboard-game&lt;br&gt;single source of truth" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="0"><mxGeometry x="355" y="615" width="250" height="64" as="geometry"/></mxCell>
        <mxCell id="note1" value="401 = Worker rejected the password&lt;br&gt;502 = n8n failed (see Executions)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=12;dashed=1;fontSize=11;" vertex="1" parent="0"><mxGeometry x="60" y="615" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="note2" value="429 = rate limit (3/player/60 s)&lt;br&gt;score = coins x100 + speed bonus" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=2;fontSize=12;dashed=1;fontSize=11;" vertex="1" parent="0"><mxGeometry x="620" y="615" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="e0" value="git push" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="repo" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="serves" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="cdn" target="game"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="169"/><mxPoint x="200" y="169"/><mxPoint x="200" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="serves" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="cdn" target="board"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="169"/><mxPoint x="760" y="169"/><mxPoint x="760" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="POST /submit&lt;br&gt;name + password + coins + ms" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="game" target="worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="GET /board&lt;br&gt;session + key + sort" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="board" target="worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="forward (secret URL)" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="worker" target="submit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="forward (secret URL)" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="worker" target="list"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="INSERT (score recomputed)" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="submit" target="table"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="SELECT rows" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="0" source="list" target="table"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="200 ranked JSON" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="0" source="submit" target="worker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="534"/><mxPoint x="20" y="404"/></Array></mxGeometry></mxCell>
